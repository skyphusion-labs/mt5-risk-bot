<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.skyphusion.mt5-risk-bot</string>
  <key>WorkingDirectory</key>
  <string>/ABS/PATH/TO/mt5-risk-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABS/PATH/TO/mt5-risk-bot/.venv/bin/python</string>
    <string>-m</string>
    <string>mt5_risk_bot</string>
    <string>run</string>
    <string>--mode</string>
    <string>paper</string>
    <string>--loop</string>
    <string>--config</string>
    <string>config.toml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TELEGRAM_BOT_TOKEN</key>
    <string>REPLACE_ME</string>
    <key>TELEGRAM_CHAT_ID</key>
    <string>REPLACE_ME</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/ABS/PATH/TO/mt5-risk-bot/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/ABS/PATH/TO/mt5-risk-bot/logs/launchd.err.log</string>
</dict>
</plist>
